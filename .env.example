PORT=3000
SITE_NAME=ZedStream
# Public address of this site. Lipila sends payment callbacks to PUBLIC_URL/api/webhooks/lipila
PUBLIC_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-string

# Admin account created on first run
ADMIN_EMAIL=admin@zedstream.local
ADMIN_PASSWORD=change-me

# Lipila mobile money
#   mock    = simulated payments, no API key needed (default when no key is set)
#   sandbox = Lipila test environment, key from https://dashboard.lipila.dev (starts with lsk_)
#   live    = real money, key from https://dashboard.lipila.io (starts with lpk_)
LIPILA_MODE=mock
LIPILA_API_KEY=
# Optional: webhook signing secret from the Lipila dashboard
LIPILA_WEBHOOK_SECRET=
